# Copy to frontend/.env to change these. Values are built into the app, so
# rebuild (or restart `npm run dev`) after changing them. Never put secrets here:
# everything starting with VITE_ is visible to anyone who opens the site.

# The product's name as people see it (sidebar, sign-in page, certificate,
# page title). Set PRODUCT_NAME in backend/.env to the same value for emails.
VITE_PRODUCT_NAME=OmniPost

# Where the dev server sends /api requests (only for `npm run dev`).
# VITE_API_PROXY_TARGET=http://localhost:8000
