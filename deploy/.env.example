# OmniPost production settings. Copy to deploy/.env on the server and fill in.
# deploy/.env is git-ignored: it never goes into the repository.
#
# Passwords and keys: generate each one separately, never reuse.
#   Passwords (URL-safe):  python -c "import secrets; print(secrets.token_hex(32))"
#   SECRET_KEY:            python -c "import secrets; print(secrets.token_urlsafe(64))"
#   FERNET_KEY:            python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing FERNET_KEY means every connected Facebook/Instagram account must reconnect.

# The site's address, without https:// (its DNS must point at this server)
DOMAIN=app.example.com

# Database logins (created on the first start, see postgres-init/01-roles.sh)
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
ADMIN_DB_PASSWORD=

REDIS_PASSWORD=

SECRET_KEY=
FERNET_KEY=

# Object storage for photos and videos (Cloudflare R2 shown)
S3_BUCKET=omnipost-media
S3_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Facebook / Instagram app (developers.facebook.com). The redirect URI to
# register there is https://<DOMAIN>/api/v1/social/callback/facebook
META_APP_ID=
META_APP_SECRET=

# Error reporting (sentry.io). Empty = off.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Capacity (defaults suit a 2-4 CPU server)
API_WORKERS=3
WORKER_CONCURRENCY=2

# Backups: every 24 h, kept 14 days in deploy/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
